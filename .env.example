# Optional. Empty or missing keeps response generation fully local.
GROQ_API_KEY=

# Production strict-JSON model and request timeout.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=8

# Optional local bilingual Faster-Whisper configuration. The multilingual model
# downloads on first use; auto detects English or Indonesian for each clip.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
WHISPER_MAX_AUDIO_SECONDS=60
