# Optional. Empty or missing keeps response generation fully local.
GEMINI_API_KEY=

# Stable low-latency model and request timeout.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=8

# Optional local Faster-Whisper configuration. The model downloads on first use.
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_MAX_AUDIO_SECONDS=60
