# Optional. Empty or missing keeps response generation fully local.
GROQ_API_KEY=

# Production strict-JSON model and request timeout.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=8

# Optional local bilingual Faster-Whisper configuration. The multilingual model
# downloads on first use; auto detects English or Indonesian for each clip.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
WHISPER_MAX_AUDIO_SECONDS=60

# Speech-to-text provider selection.
# local (default) -> Faster-Whisper runs on CPU; audio stays on device.
# groq            -> Groq Whisper cloud STT; audio is uploaded to Groq.
STT_PROVIDER=local

# Groq Whisper STT configuration (only used when STT_PROVIDER=groq).
# whisper-large-v3-turbo is faster and cheaper; whisper-large-v3 is more accurate.
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_LANGUAGE=auto
GROQ_STT_TIMEOUT_SECONDS=30
